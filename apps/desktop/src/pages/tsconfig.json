{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ES2022",
        "moduleResolution": "bundler",
        "moduleDetection": "legacy",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "types": [],
        "rootDir": ".",
        "outDir": "../../dist/pages",
        "strict": true,
        "skipLibCheck": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true
    },
    "include": ["."]
}
